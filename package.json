{
  "name": "opskitpro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:clean": "npx kill-port 3000 || true && playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:watch": "playwright test --headed --workers=1 --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "package:standalone": "bash scripts/package-standalone.sh",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "check:forbidden-imports": "grep -R \"cloudflare:sockets\" src >/dev/null && exit 1 || exit 0",
    "verify:fast": "npm run check:forbidden-imports && npm run build && npm run test",
    "verify": "npm run verify:fast && npm run test:e2e:clean"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.5.10",
    "@opennextjs/cloudflare": "^1.15.1",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "framer-motion": "^11.18.2",
    "gray-matter": "^4.0.3",
    "ipaddr.js": "^2.4.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.477.0",
    "negotiator": "^1.0.0",
    "next": "^14.2.35",
    "next-mdx-remote": "^6.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/negotiator": "^0.6.3",
    "@types/node": "^20.17.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.27.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.23",
    "jsdom": "^29.0.1",
    "lefthook": "^2.1.9",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vitest": "^4.1.2",
    "wrangler": "^4.77.0"
  }
}
