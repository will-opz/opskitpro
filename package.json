{
  "name": "opskitpro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:clean": "npx kill-port 3000 || true && playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:watch": "playwright test --headed --workers=1 --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:edge-probe": "vitest run workers/edge-probe/src/index.test.ts",
    "edge-probe:check": "npm run test:edge-probe && WRANGLER_LOG_PATH=/tmp/opskitpro-edge-probe-wrangler.log WRANGLER_SEND_METRICS=false npx wrangler@4.114.0 deploy --dry-run --config workers/edge-probe/wrangler.jsonc",
    "edge-probe:deploy": "npx wrangler@4.114.0 deploy --config workers/edge-probe/wrangler.jsonc",
    "package:standalone": "bash scripts/package-standalone.sh",
    "deploy": "npm run package:standalone",
    "check:forbidden-imports": "grep -R \"cloudflare:sockets\" src >/dev/null && exit 1 || exit 0",
    "verify:content": "node scripts/verify-content.js",
    "verify:fast": "npm run check:forbidden-imports && npm run verify:content && npm run lint && npm run typecheck && npm run typecheck:test && npm run build && npm run test",
    "verify": "npm run verify:fast && npm run test:e2e:clean",
    "generate:post": "node scripts/generate-post.js"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.5.10",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "framer-motion": "^11.18.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "ipaddr.js": "^2.4.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.477.0",
    "negotiator": "^1.0.0",
    "next": "^16.2.11",
    "next-mdx-remote": "^6.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-pretty-code": "^0.14.4",
    "rehype-slug": "^6.0.0",
    "server-only": "^0.0.1",
    "shiki": "^4.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/negotiator": "^0.6.3",
    "@types/node": "^20.17.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^29.0.1",
    "lefthook": "^2.1.9",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vitest": "^4.1.2"
  }
}
